# ==============================================================================
# Privara – Privacy-Preserving Federated Learning Simulator
# Environment Configuration Template (.env.example)
# Copy this file to .env and adjust values as needed.
# ==============================================================================

# --- Server & Streamlit Settings ---
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# --- Execution & Hardware Optimization ---
PYTHONUNBUFFERED=1
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
TORCH_NUM_THREADS=4
DEVICE=cpu                     # 'cpu' or 'cuda' (auto-detected if CUDA is available)

# --- Reproducibility ---
PYTHONHASHSEED=42
RANDOM_SEED=42

# --- Default Federated Learning Configuration ---
PRIVARA_DATASET=Synthetic      # Options: Synthetic, MNIST, FashionMNIST
PRIVARA_NUM_CLIENTS=5
PRIVARA_NUM_ROUNDS=3
PRIVARA_PARTITION_STRATEGY=dirichlet   # Options: iid, dirichlet, label_skew
PRIVARA_DIRICHLET_ALPHA=0.5
PRIVARA_BATCH_SIZE=32
PRIVARA_LOCAL_EPOCHS=1
PRIVARA_LEARNING_RATE=0.01

# --- Differential Privacy (DP-SGD) ---
PRIVARA_DP_ENABLED=true
PRIVARA_NOISE_MULTIPLIER=1.0   # sigma (Gaussian noise scale calibrated to clip norm)
PRIVARA_MAX_GRAD_NORM=1.2      # C (L2 gradient clipping threshold)
PRIVARA_TARGET_DELTA=0.00001   # delta (typically 1e-5)
PRIVARA_ACCOUNTANT=rdp         # Options: rdp, prv

# --- Gradient Compression & Communication ---
PRIVARA_COMPRESSION_ENABLED=true
PRIVARA_COMPRESSION_METHOD=topk
PRIVARA_TOPK_RATIO=0.5         # Retain top 50% magnitude elements (sparse)
PRIVARA_COMM_BUDGET_MB=20.0
PRIVARA_BUDGET_MODE=bidirectional
PRIVARA_ENFORCE_POLICY=reject  # Options: reject, throttle, warn

# --- Reliability Simulation ---
PRIVARA_DROPOUT_PROB=0.1       # Emulate client disconnects
PRIVARA_STRAGGLER_PROB=0.1     # Emulate slow client devices
